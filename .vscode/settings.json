{
  "bashLearn.language": "es",
  "workbench.startupEditor": "none",
  "terminal.integrated.defaultProfile.linux": "bash",
  "files.exclude": {
    "course": true,
    ".bash-learn": true,
    "**/.exercise": true
  },
  "files.eol": "\n",
  "files.insertFinalNewline": true,
  "[shellscript]": {
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "shellcheck.enable": true,
  "chat.disableAIFeatures": true
}
